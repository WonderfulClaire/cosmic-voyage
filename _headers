# Cloudflare Pages 缓存规则（GitHub Pages 会忽略此文件，迁移到 Cloudflare 后自动生效）
# 不可变静态资源：缓存一年
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# JS / CSS：缓存一天（带内容指纹或靠 SW 刷新）
/*.js
  Cache-Control: public, max-age=86400
/*.css
  Cache-Control: public, max-age=86400
# HTML：不缓存，始终拿最新（配合 Service Worker 离线兜底）
/*.html
  Cache-Control: public, max-age=0, must-revalidate
